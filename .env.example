# BK-IDS SOC: Environment Configuration — NGIPS Lean v3.0
# ============================================================
# SECURITY NOTICE: This file contains sensitive credentials.
# - Copy to .env and chmod 600 .env
# - NEVER commit .env to version control
# - Rotate all passwords on deployment
# ============================================================

# ==========================================
# MYSQL DATABASE
# ==========================================
MYSQL_HOST=mysql_db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS>
MYSQL_DATABASE=bk_ids
MYSQL_USER=bk_ids_app
MYSQL_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS>

# ==========================================
# REDIS — AUTHENTICATION REQUIRED
# Used only for: rate limiting, cooldown cache, alert dedup
# NOT used as event bus or durable message queue
# ==========================================
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS>

# ==========================================
# JWT AUTHENTICATION — FIXED SECRET (NO RANDOM FALLBACK)
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
# WARNING: If this variable is missing, the API will REFUSE to start.
# ==========================================
JWT_SECRET_KEY=<CHANGE_ME_128_CHAR_HEX>
JWT_EXPIRY_HOURS=8
JWT_REFRESH_DAYS=7

# ==========================================
# BK-IDS ADMIN USER
# ==========================================
# Default admin password — CHANGE ON FIRST LOGIN
ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==========================================
# SNORT 3 NGIPS ENGINE
# ==========================================
# Network interface for packet capture
SNIFF_INTERFACE=ens33
# Home network CIDR — used in snort.lua and SOAR whitelist logic
HOME_NET=192.168.13.0/24
# Number of Snort packet processing threads (conservative default for lab)
SNORT_THREADS=2
# Log directory inside Snort container (must match snort_logs volume mount)
SNORT_LOG_DIR=/var/log/snort

# ==========================================
# SNORT ALERT INGESTION (LogWatchdog)
# ==========================================
# Path to Snort alert_json output file (inside api_server container)
SNORT_ALERT_FILE=/var/log/snort/alert_json.txt
# Watchdog poll interval in seconds
WATCHDOG_POLL_INTERVAL=1

# ==========================================
# NETWORK / FIREWALL CONFIG
# ==========================================
# IPs that are NEVER blocked by SOAR (comma-separated)
WHITELIST_IPS=127.0.0.1,192.168.13.1,192.168.13.128
# Also suppress these source IPs from alert ingestion/dashboard noise.
SUPPRESS_WHITELISTED_ALERTS=true

# ==========================================
# SOAR (Security Orchestration, Automation & Response)
# ==========================================
SOAR_ENABLED=true
SOAR_AUTO_BLOCK=true
# Duration (seconds) an IP remains blocked before auto-unban
SOAR_BAN_DURATION=3600
# Maximum auto-block actions per minute (rate limit)
SOAR_MAX_BLOCKS_PER_MINUTE=10
# Cooldown window (seconds) before re-blocking same IP
SOAR_COOLDOWN_SEC=300
# Minimum alert severity to trigger auto-block: low/medium/high/critical
SOAR_BLOCK_MIN_SEVERITY=high
# Alert count threshold within cooldown window to trigger block
SOAR_BLOCK_THRESHOLD=3
# Audit log file path (inside api_server container)
SOAR_AUDIT_LOG_FILE=/app/storage/soar_audit.jsonl

# ==========================================
# TELEGRAM SOAR ALERTS (optional)
# ==========================================
TELEGRAM_CHAT_ID=<YOUR_CHAT_ID>
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>

# ==========================================
# AI/ML ENGINE (optional — OpenRouter)
# ==========================================
OPENROUTER_API_KEY=<YOUR_API_KEY>

# ==========================================
# PCAP FORENSICS (optional)
# ==========================================
PCAP_STORAGE_DIR=/app/storage/pcaps
PCAP_CAPTURE_DURATION=60
PCAP_INTERFACE=ens33
PCAP_RETENTION_DAYS=7
PCAP_MAX_FILES=1000

# ==========================================
# THREAT INTEL (optional)
# ==========================================
ABUSEIPDB_API_KEY=
