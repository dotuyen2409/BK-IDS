# ==================================================================
# BK-IDS SOC: TỆP LUẬT SNORT 3 (LOCAL RULES)
# Tự động đồng bộ từ Database - Không chỉnh sửa thủ công
# ==================================================================

# --- KIM BÀI MIỄN TỬ (WHITELIST TỪ .ENV) ---
pass ip 127.0.0.1 any <> any any (msg:"Bypass Whitelist IP 127.0.0.1"; sid:100000; rev:1;)
pass ip 192.168.142.1 any <> any any (msg:"Bypass Whitelist IP 192.168.142.1"; sid:100001; rev:1;)
pass ip 192.168.142.128 any <> any any (msg:"Bypass Whitelist IP 192.168.142.128"; sid:100002; rev:1;)
# -------------------------------------------

drop tcp any any -> any any (msg:"[DROP] SQL Injection get version"; content:"convert(int,@@version)",nocase; classtype:web-application-attack; sid:1000001; rev:5;)

drop tcp any any -> any any (msg:"[DROP] HTTP Flood DoS Attack Detected"; flow:established,to_server; content:"GET"; http_method; detection_filter:track by_src, count 50, seconds 5; sid:1000002; rev:1;)
